  {
    "id": "P5",
    "category": "Greetings",
    "translations": {
      "sv": "Hur kan jag hjälpa dig?",
      "en": "How can I help you?",
      "fr": "Comment puis-je vous aider ?",
      "sq": "Si mund t'ju ndihmoj?",
      "ar": "كيف يمكنني مساعدتك؟",
      "ru": "Как я могу вам помочь?"
    },
    "audio": {}
  },
  {
    "id": "P6",
    "category": "Greetings",
    "translations": {
      "sv": "Var har du ont?",
      "en": "Where does it hurt?",
      "fr": "Où avez-vous mal ?",
      "sq": "Ku keni dhimbje?",
      "ar": "أين تشعر بالألم؟",
      "ru": "Где у вас болит?"
    },
    "audio": {}
  },
  {
    "id": "P7",
    "category": "Greetings",
    "translations": {
      "sv": "Hur ont gör det från ett till tio?",
      "en": "How bad is the pain from one to ten?",
      "fr": "À quel point la douleur est-elle forte de un à dix ?",
      "sq": "Sa e fortë është dhimbja nga një deri në dhjetë?",
      "ar": "ما شدة الألم من واحد إلى عشرة؟",
      "ru": "Насколько сильна боль по шкале от одного до десяти?"
    },
    "audio": {}
  },
  {
    "id": "P8",
    "category": "Greetings",
    "translations": {
      "sv": "Kan du visa var det gör ont?",
      "en": "Can you show where it hurts?",
      "fr": "Pouvez-vous montrer où vous avez mal ?",
      "sq": "A mund të tregoni ku ju dhemb?",
      "ar": "هل يمكنك أن تُريني أين يؤلمك؟",
      "ru": "Можете показать, где болит?"
    },
    "audio": {}
  },
  {
    "id": "P9",
    "category": "Greetings",
    "translations": {
      "sv": "Behöver du hjälp nu?",
      "en": "Do you need help now?",
      "fr": "Avez-vous besoin d'aide maintenant ?",
      "sq": "A keni nevojë për ndihmë tani?",
      "ar": "هل تحتاج إلى مساعدة الآن؟",
      "ru": "Вам нужна помощь сейчас?"
    },
    "audio": {}
  },
  {
    "id": "P10",
    "category": "Greetings",
    "translations": {
      "sv": "Tack, vi ska hjälpa dig",
      "en": "Thank you, we will help you",
      "fr": "Merci, nous allons vous aider",
      "sq": "Faleminderit, ne do t'ju ndihmojmë",
      "ar": "شكراً، سنساعدك",
      "ru": "Спасибо, мы вам поможем"
    },
    "audio": {}
  },
  {
